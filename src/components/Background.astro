---

---

<div class="ambient-background"></div>

<svg width="0" height="0" class="absolute">
  <defs>
    <filter id="noiseFilter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.9"
        numOctaves="4"
        stitchTiles="stitch"></feTurbulence>
    </filter>
  </defs>
</svg>

<style>
  .ambient-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        circle at 20% 30%,
        rgba(245, 245, 220, 0.3) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(169, 169, 169, 0.2) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 40% 80%,
        rgba(211, 211, 211, 0.25) 0%,
        transparent 50%
      ),
      linear-gradient(
        135deg,
        #f5f5dc 0%,
        #e8e8e8 25%,
        #d3d3d3 50%,
        #c0c0c0 75%,
        #a9a9a9 100%
      );
    z-index: -2;
  }

  .ambient-background::before,
  .ambient-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: inherit;
  }

  .ambient-background::before {
    filter: url(#noiseFilter);
    opacity: 1;
    animation: drift 45s linear infinite;
  }

  .ambient-background::after {
    filter: url(#noiseFilter) contrast(170%) brightness(1000%);
    opacity: 0.3;
    mix-blend-mode: overlay;
    animation: drift 60s linear infinite reverse;
  }

  @keyframes drift {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-2px, -2px);
    }
    50% {
      transform: translate(2px, -1px);
    }
    75% {
      transform: translate(-1px, 2px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>
