---

<div class="ambient-background"></div>

<svg width="0" height="0" class="absolute">
  <defs>
    <filter id="noiseFilter">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.9"
        numOctaves="4"
        stitchTiles="stitch"></feTurbulence>
    </filter>
  </defs>
</svg>

<style>
  .ambient-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        circle at 20% 30%,
        color-mix(in srgb, var(--color-grain-1) 30%, transparent) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        color-mix(in srgb, var(--color-grain-3) 20%, transparent) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 40% 80%,
        color-mix(in srgb, var(--color-grain-2) 25%, transparent) 0%,
        transparent 50%
      ),
      linear-gradient(
        135deg,
        var(--color-grain-1) 0%,
        var(--color-grain-2) 33%,
        var(--color-grain-3) 66%,
        var(--color-grain-4) 100%
      );
    z-index: -2;
  }

  .ambient-background::before,
  .ambient-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: inherit;
  }

  .ambient-background::before {
    filter: url(#noiseFilter);
    opacity: var(--grain-before-opacity);
    animation: drift 45s linear infinite;
  }

  .ambient-background::after {
    filter:
      url(#noiseFilter) contrast(var(--grain-after-contrast))
      brightness(var(--grain-after-brightness));
    opacity: var(--grain-after-opacity);
    mix-blend-mode: overlay;
    animation: drift 60s linear infinite reverse;
  }

  @keyframes drift {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-2px, -2px);
    }
    50% {
      transform: translate(2px, -1px);
    }
    75% {
      transform: translate(-1px, 2px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>
