---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat-card hard-shadow-hover" style="--hard-shadow-offset: 5px">
  <span class="stat-card__value" data-count-value={value}>{value}</span>
  <span class="stat-card__label">{label}</span>
</div>

<style>
  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 1.5rem 1rem;
    border-radius: 1rem;
    border: 2px solid var(--color-outline-variant);
    background-color: var(--color-surface-container-high);
    text-align: center;
  }

  .stat-card__value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-on-background);
  }

  .stat-card__label {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
</style>
