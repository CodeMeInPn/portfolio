---
---

<svg id="page-ribbon" class="page-ribbon hidden md:block" aria-hidden="true"></svg>

<style>
  .page-ribbon {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    pointer-events: none;
    overflow: visible;
  }
</style>

<style is:global>
  .page-ribbon__band {
    opacity: 0.85;
  }

  .page-ribbon__band.is-revealing {
    animation: page-ribbon-reveal 5s ease-out both;
  }

  @keyframes page-ribbon-reveal {
    from {
      stroke-dashoffset: var(--reveal-length);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .page-ribbon__word {
    fill: #ffffff;
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.02em;
    dominant-baseline: central;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-ribbon__band.is-revealing {
      animation: none;
    }

    .page-ribbon__word {
      opacity: 0;
    }
  }
</style>

<script>
  import {
    buildCrossing,
    buildLoop,
    buildStripes,
    distributeWords,
    STRIPE_SPACING,
    STRIPE_WIDTH,
    type Pt,
    type Stripe,
  } from '../lib/ribbon';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  // Distance from the content column's edge to the ribbon's centerline —
  // keeps the ribbon hugging the sections instead of hanging out near the
  // viewport edge. Must clear the bundle's own max reach (see TURN_RADIUS
  // below) plus a visible gap, or the ribbon touches the content.
  const CONTENT_GAP = 80;
  // Room kept between the hero loop's outer bulge and the viewport edge.
  const EDGE_MARGIN = 28;
  // A turn's radius has to clear how far the offset stripes reach from the
  // spine (up to 1.5 stripe-spacings) plus half the stroke width, or the
  // innermost stripe's stroke overlaps itself through the curve instead of
  // tracing a clean arc — that self-overlap is what rendered as a blocky
  // rectangle at the old, too-tight radius.
  const MIN_CLEAN_RADIUS = 1.5 * STRIPE_SPACING + STRIPE_WIDTH / 2 + 16;
  const TURN_RADIUS = MIN_CLEAN_RADIUS;
  // The hero loop's ideal radius — used when there's room for it. Its exit
  // lands exactly on the content-hugging line (xRight), so unlike the
  // section-to-section crossings there's no separate lateral shift after
  // it; the loop's own radius is what has to fit in whatever gutter sits
  // between that line and the viewport edge, so it's clamped down instead
  // of forcing MIN_CLEAN_RADIUS and overflowing on narrower desktop widths.
  const DESIRED_LOOP_RADIUS = 90;
  const LOOP_Y_FROM_HERO_TOP = 150;
  const ARC_STEPS = 28;
  const LOOP_STEPS = 120;
  const WORD_PX_PER_WORD = 260;
  const REVEAL_TOTAL_MS = 6200; // last stripe delay (1.2s) + 5s reveal duration
  const WORD_SPEED_PX_PER_SEC = 60;
  const FADE_MARGIN = 0.08;
  // How much of the ribbon's tail fades out before it would otherwise run
  // into the footer.
  const FOOTER_FADE_HEIGHT = 220;

  function init() {
    const svg = document.getElementById('page-ribbon') as SVGSVGElement | null;
    if (!svg) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mq = window.matchMedia('(min-width: 768px)');

    let hasRevealed = false;
    let rafId: number | null = null;
    let revealTimer: number | null = null;
    let runners: Array<{ textPath: SVGTextPathElement; textEl: SVGTextElement; length: number; offset: number }> =
      [];

    function pageY(rectTop: number) {
      return rectTop + window.scrollY;
    }

    function buildSpine(): Pt[] | null {
      const heroEl = document.getElementById('hero');
      const content = document.querySelector<HTMLElement>('#about .section-ribbon-content');
      const aboutGap = document.querySelector<HTMLElement>('#about .section-ribbon-gap');
      const projectsGap = document.querySelector<HTMLElement>('#projects .section-ribbon-gap');
      const contactGap = document.querySelector<HTMLElement>('#contact .section-ribbon-gap');
      const contactSection = document.getElementById('contact');

      if (!heroEl || !content || !aboutGap || !projectsGap || !contactGap || !contactSection) {
        return null;
      }

      const heroTop = pageY(heroEl.getBoundingClientRect().top);
      const contentRect = content.getBoundingClientRect();
      const aboutGapRect = aboutGap.getBoundingClientRect();
      const projectsGapRect = projectsGap.getBoundingClientRect();
      const contactGapRect = contactGap.getBoundingClientRect();

      const aboutGapTop = pageY(aboutGapRect.top);
      const aboutGapBottom = pageY(aboutGapRect.bottom);
      const projectsGapTop = pageY(projectsGapRect.top);
      const projectsGapBottom = pageY(projectsGapRect.bottom);
      const contactGapTop = pageY(contactGapRect.top);
      const contactGapBottom = pageY(contactGapRect.bottom);
      const contactBottom = pageY(contactSection.getBoundingClientRect().bottom);

      // clientWidth (not innerWidth) excludes the scrollbar gutter, which
      // matters here since the svg is sized to this value directly.
      const vw = document.documentElement.clientWidth;
      // Hug the actual content column instead of the viewport edge.
      const xRight = contentRect.right + CONTENT_GAP;
      const xLeft = contentRect.left - CONTENT_GAP;

      // The loop's exit sits directly on xRight, so its own radius has to
      // fit within whatever gutter is actually available out to the
      // viewport edge at this width — content maxes out at 75rem, so on
      // common desktop widths that gutter is nowhere near 2x a full-size
      // loop's diameter. A fixed radius either overflowed the viewport or
      // (when a follow-up crossing tried to shift it back in afterward)
      // produced a shift smaller than the crossing's own radius, which
      // made the S-curve fold back on itself — the "rectangle" artifact.
      const loopGutter = vw - EDGE_MARGIN - xRight;
      // Never exceeds loopGutter / 2 — that would overflow the viewport —
      // even though that can mean settling for less than MIN_CLEAN_RADIUS
      // on a narrower desktop width. A slightly tight loop reads fine; an
      // overflowing one or a folded-back crossing doesn't.
      const loopRadius = Math.max(20, Math.min(DESIRED_LOOP_RADIUS, loopGutter / 2));
      const loopCenter: Pt = {
        x: xRight + loopRadius,
        y: heroTop + LOOP_Y_FROM_HERO_TOP,
      };
      const entryY = loopCenter.y + loopRadius;

      return [
        { x: 0, y: entryY },
        { x: loopCenter.x, y: entryY },
        ...buildLoop(loopCenter, loopRadius, LOOP_STEPS),
        // The loop's exit (loopCenter.x - loopRadius) equals xRight by
        // construction, so this just runs straight down to the About
        // boundary — crossing the entry line once on the way, like any
        // ribbon crossing itself, but with no further lateral shift needed.
        { x: xRight, y: aboutGapTop },
        ...buildCrossing(xRight, xRight, aboutGapTop, aboutGapBottom, TURN_RADIUS, ARC_STEPS),
        { x: xRight, y: projectsGapTop },
        ...buildCrossing(xRight, xLeft, projectsGapTop, projectsGapBottom, TURN_RADIUS, ARC_STEPS),
        { x: xLeft, y: contactGapTop },
        ...buildCrossing(xLeft, xRight, contactGapTop, contactGapBottom, TURN_RADIUS, ARC_STEPS),
        { x: xRight, y: contactBottom },
      ];
    }

    function stopRunners() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      if (revealTimer !== null) {
        window.clearTimeout(revealTimer);
        revealTimer = null;
      }
    }

    function startRunners() {
      let last = performance.now();
      function tick(now: number) {
        const dt = (now - last) / 1000;
        last = now;
        for (const r of runners) {
          r.offset = (r.offset + WORD_SPEED_PX_PER_SEC * dt) % r.length;
          r.textPath.setAttribute('startOffset', String(r.offset));
          const frac = r.offset / r.length;
          const fadeIn = Math.min(1, frac / FADE_MARGIN);
          const fadeOut = Math.min(1, (1 - frac) / FADE_MARGIN);
          r.textEl.style.opacity = String(Math.min(fadeIn, fadeOut));
        }
        rafId = requestAnimationFrame(tick);
      }
      rafId = requestAnimationFrame(tick);
    }

    function createPath(stripe: Stripe, revealing: boolean): SVGPathElement {
      const path = document.createElementNS(SVG_NS, 'path');
      path.setAttribute('id', `page-ribbon-band-${stripe.name}`);
      path.setAttribute('d', stripe.d);
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', stripe.color);
      path.setAttribute('stroke-width', String(STRIPE_WIDTH));
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('pathLength', String(stripe.length));
      path.classList.add('page-ribbon__band');
      path.style.setProperty('--reveal-length', String(stripe.length));
      path.style.strokeDasharray = String(stripe.length);
      if (revealing) {
        path.classList.add('is-revealing');
        path.style.animationDelay = `${stripe.delay}s`;
      } else {
        path.style.strokeDashoffset = '0';
      }
      return path;
    }

    /** A mask that fades the ribbon out over its last FOOTER_FADE_HEIGHT px, so it doesn't run straight into the footer. */
    function buildFadeMask(vw: number, docHeight: number, fadeStart: number): SVGGElement {
      const fadeTop = Math.max(0, fadeStart - FOOTER_FADE_HEIGHT);
      const gradientId = 'page-ribbon-fade-gradient';
      const maskId = 'page-ribbon-fade-mask';

      const gradient = document.createElementNS(SVG_NS, 'linearGradient');
      gradient.setAttribute('id', gradientId);
      gradient.setAttribute('gradientUnits', 'userSpaceOnUse');
      gradient.setAttribute('x1', '0');
      gradient.setAttribute('x2', '0');
      gradient.setAttribute('y1', String(fadeTop));
      gradient.setAttribute('y2', String(fadeStart));
      const stopStart = document.createElementNS(SVG_NS, 'stop');
      stopStart.setAttribute('offset', '0');
      stopStart.setAttribute('stop-color', '#fff');
      const stopEnd = document.createElementNS(SVG_NS, 'stop');
      stopEnd.setAttribute('offset', '1');
      stopEnd.setAttribute('stop-color', '#000');
      gradient.append(stopStart, stopEnd);

      const opaqueRect = document.createElementNS(SVG_NS, 'rect');
      opaqueRect.setAttribute('x', '0');
      opaqueRect.setAttribute('y', '0');
      opaqueRect.setAttribute('width', String(vw));
      opaqueRect.setAttribute('height', String(fadeTop));
      opaqueRect.setAttribute('fill', '#fff');

      const fadeRect = document.createElementNS(SVG_NS, 'rect');
      fadeRect.setAttribute('x', '0');
      fadeRect.setAttribute('y', String(fadeTop));
      fadeRect.setAttribute('width', String(vw));
      fadeRect.setAttribute('height', String(docHeight - fadeTop));
      fadeRect.setAttribute('fill', `url(#${gradientId})`);

      const mask = document.createElementNS(SVG_NS, 'mask');
      mask.setAttribute('id', maskId);
      mask.setAttribute('maskUnits', 'userSpaceOnUse');
      mask.setAttribute('x', '0');
      mask.setAttribute('y', '0');
      mask.setAttribute('width', String(vw));
      mask.setAttribute('height', String(docHeight));
      mask.append(opaqueRect, fadeRect);

      const defs = document.createElementNS(SVG_NS, 'defs');
      defs.append(gradient, mask);

      const group = document.createElementNS(SVG_NS, 'g');
      group.setAttribute('mask', `url(#${maskId})`);
      svg.append(defs, group);
      return group;
    }

    function build() {
      if (!mq.matches) {
        stopRunners();
        return;
      }

      const spine = buildSpine();
      if (!spine) return;

      const isFirstBuild = !hasRevealed;
      // clientWidth (not innerWidth) excludes the scrollbar gutter, which
      // matters here since the svg is sized to this value directly.
      const vw = document.documentElement.clientWidth;
      const docHeight = document.documentElement.scrollHeight;
      svg.setAttribute('width', String(vw));
      svg.setAttribute('height', String(docHeight));

      const stripes = buildStripes(spine);
      const contactBottom = spine[spine.length - 1].y;

      stopRunners();
      svg.replaceChildren();
      const group = buildFadeMask(vw, docHeight, contactBottom);

      const revealing = !prefersReducedMotion && isFirstBuild;
      for (const stripe of stripes) {
        group.appendChild(createPath(stripe, revealing));
      }

      const nativeLengths = new Map<string, number>();
      for (const stripe of stripes) {
        const guide = document.getElementById(`page-ribbon-band-${stripe.name}`) as SVGGeometryElement | null;
        nativeLengths.set(stripe.name, guide ? guide.getTotalLength() : stripe.length);
      }

      const totalWords = Math.max(4, Math.round((nativeLengths.get('middle') ?? 0) / WORD_PX_PER_WORD));
      const words = distributeWords(stripes, totalWords);

      runners = [];
      for (const w of words) {
        const length = nativeLengths.get(w.stripeName) ?? 0;
        if (length <= 0) continue;

        const text = document.createElementNS(SVG_NS, 'text');
        text.classList.add('page-ribbon__word');
        const textPath = document.createElementNS(SVG_NS, 'textPath');
        textPath.classList.add('page-ribbon__wordpath');
        textPath.setAttribute('href', `#page-ribbon-band-${w.stripeName}`);
        textPath.setAttribute('startOffset', '0');
        textPath.textContent = w.word;
        text.appendChild(textPath);
        group.appendChild(text);

        const slot = (w.index + 0.5) / w.groupSize;
        const jitter = (Math.random() - 0.5) * (1 / w.groupSize) * 0.6;
        const offset = Math.min(1, Math.max(0, slot + jitter)) * length;

        runners.push({ textPath, textEl: text, length, offset });
      }

      hasRevealed = true;

      if (!prefersReducedMotion) {
        if (isFirstBuild) {
          revealTimer = window.setTimeout(startRunners, REVEAL_TOTAL_MS);
        } else {
          startRunners();
        }
      }
    }

    let resizeTimer: number | undefined;
    function scheduleRebuild() {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 150);
    }

    window.addEventListener('load', build);
    window.addEventListener('resize', scheduleRebuild);
    mq.addEventListener('change', scheduleRebuild);

    // 'load' may already have fired by the time this module runs (e.g. a
    // slow-to-parse script tag) — in that case it's the only initial build,
    // so it must still happen. Calling both `load` and an unconditional
    // immediate build here was the bug that broke the reveal: the second
    // call landed a moment after the first and, since `hasRevealed` was
    // already true, replaced the still-animating paths with fully-revealed
    // static ones before the reveal was visible.
    if (document.readyState === 'complete') {
      build();
    }
  }

  init();
</script>
