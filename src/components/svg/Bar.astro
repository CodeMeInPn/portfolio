---
import type { PropsWithClassName } from 'src/types';
import { cva } from 'class-variance-authority';
import { cn } from 'utils/cn';
import type { BarOptionPosition } from 'src/types/bar.types';

type Props = PropsWithClassName<{
  width?: number | string;
  height?: number | string;
  position?: 'horizontal' | 'vertical';
  inverted?: boolean;
  offset?: BarOptionPosition;
}>;

const {
  className = '',
  position = 'horizontal',
  inverted = false,
  offset,
} = Astro.props;

const barVariants = cva(['block'], {
  variants: {
    position: {
      vertical: 'h-full flex',
      horizontal: 'h-8',
    },
  },
  defaultVariants: {
    position: 'horizontal',
  },
});

const mergedClassnames = cn(barVariants({ position }), className);
---

{
  position === 'vertical' ? (
    <div class={mergedClassnames}>
      {offset === 'left' && <div class="bg-transparent size-full" />}
      <div
        class={cn('bg-section-snake-outer size-full', {
          'bg-section-snake-inner': inverted,
        })}
      />
      <div class="bg-section-snake-middle size-full" />
      <div
        class={cn('bg-section-snake-inner size-full', {
          'bg-section-snake-outer': inverted,
        })}
      />
      {offset === 'right' && <div class="bg-transparent size-full" />}
    </div>
  ) : (
    <div class={mergedClassnames}>
      {offset === 'top' && <div class="bg-transparent size-full" />}
      <div
        class={cn('bg-section-snake-outer size-full', {
          'bg-section-snake-inner': inverted,
        })}
      />
      <div class="bg-section-snake-middle size-full" />
      <div
        class={cn('bg-section-snake-inner size-full', {
          'md:bg-section-snake-outer': inverted,
        })}
      />
      {offset === 'bottom' && <div class="bg-transparent size-full" />}
    </div>
  )
}
