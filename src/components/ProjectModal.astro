---
import Button from '@components/Button.astro';
---

<dialog
  id="project-modal"
  aria-labelledby="modal-title"
  aria-describedby="modal-desc"
>
  <div class="modal-inner">
    <div class="modal-accent" aria-hidden="true"></div>
    <button id="modal-close" aria-label="Close modal" class="modal-close">
      ✕
    </button>

    <img id="modal-img" src="" alt="" class="modal-img" hidden />

    <div class="modal-content">
      <h2 id="modal-title" class="font-display text-3xl font-bold text-on-background mb-3"></h2>
      <p id="modal-desc" class="text-on-surface-variant mb-5"></p>
      <ul id="modal-tech" class="flex flex-wrap gap-2 mb-6" aria-label="Technologies"></ul>
      <Button
        id="modal-link"
        href="#"
        variant="naked"
        icon="→"
        iconPosition="right"
        className="modal-cta"
      >
        Read more
      </Button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('project-modal') as HTMLDialogElement;
  const closeBtn = document.getElementById('modal-close') as HTMLButtonElement;
  const imgEl = document.getElementById('modal-img') as HTMLImageElement;
  const titleEl = document.getElementById('modal-title') as HTMLHeadingElement;
  const descEl = document.getElementById('modal-desc') as HTMLParagraphElement;
  const techEl = document.getElementById('modal-tech') as HTMLUListElement;
  const linkEl = document.getElementById('modal-link') as HTMLAnchorElement;

  let triggerButton: HTMLElement | null = null;

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-project]');
    if (!btn) return;

    const project = JSON.parse(btn.dataset.project!);

    titleEl.textContent = project.title;
    descEl.textContent = project.fullDescription;
    linkEl.href = `/projects/${project.slug}`;

    techEl.innerHTML = project.technologies
      .map(
        (tech: string) =>
          `<li class="px-2 py-1 text-xs rounded-md bg-surface-container-high text-on-surface-variant">${tech}</li>`,
      )
      .join('');

    if (project.imageUrl) {
      imgEl.src = project.imageUrl;
      imgEl.alt = project.imageAlt;
      imgEl.hidden = false;
    } else {
      imgEl.hidden = true;
    }

    triggerButton = btn;
    dialog.showModal();
  });

  closeBtn.addEventListener('click', () => dialog.close());

  dialog.addEventListener('close', () => {
    triggerButton?.focus();
    triggerButton = null;
  });
</script>

<style>
  #project-modal {
    background-color: var(--color-surface-container);
    border-radius: 1rem;
    padding: 0;
    width: min(90vw, 36rem);
    max-height: 85vh;
    overflow-y: auto;
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    transform: translate(-50%, -50%);
    opacity: 1;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  @starting-style {
    #project-modal[open] {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 1.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #project-modal {
      transition: none;
    }
  }

  #project-modal::backdrop {
    background-color: rgb(0 0 0 / 0.5);
  }

  .modal-inner {
    position: relative;
    padding: 1.5rem;
  }

  .modal-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background: linear-gradient(
      to bottom,
      var(--color-section-snake-outer),
      var(--color-section-snake-middle),
      var(--color-section-snake-inner)
    );
    border-radius: 9999px;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: var(--color-on-surface-variant);
    line-height: 1;
    padding: 0.25rem;
  }

  .modal-close:hover {
    color: var(--color-on-background);
  }

  .modal-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .modal-content {
    margin-top: 0.5rem;
  }

  .modal-cta {
    color: var(--color-primary);
  }
</style>
