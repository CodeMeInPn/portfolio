---
const links = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-background border-b border-outline-variant h-16 flex items-center px-4">
  <div class="max-w-content-hero mx-auto w-full flex items-center justify-between">
    <span class="text-on-background font-semibold text-xl">CodeMeIn</span>

    <ul class="hidden md:flex gap-8">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              class="nav-link relative text-on-background hover:text-primary transition-colors duration-300 ease-in-out text-lg after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-primary after:transition-[width] after:duration-300 after:ease-in-out hover:after:w-full"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="hamburger-btn"
      aria-label="Toggle navigation menu"
      class="md:hidden flex flex-col gap-[6px] p-2 cursor-pointer"
    >
      <span class="block w-6 h-[2px] bg-on-background"></span>
      <span
        id="hamburger-middle"
        class="block w-6 h-[2px] bg-on-background transition-transform duration-300 ease-in-out"
      ></span>
      <span class="block w-6 h-[2px] bg-on-background"></span>
    </button>
  </div>
</nav>

<div
  id="drawer-backdrop"
  class="fixed inset-0 z-40 bg-scrim/50 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out md:hidden"
></div>

<aside
  id="nav-drawer"
  class="fixed top-16 right-0 bottom-0 z-50 w-64 bg-background border-l border-outline-variant translate-x-full transition-transform duration-300 ease-in-out md:hidden"
>
  <ul class="flex flex-col p-6 gap-6">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-drawer-link relative text-on-background hover:text-primary transition-colors duration-300 ease-in-out text-2xl after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-primary after:transition-[width] after:duration-300 after:ease-in-out hover:after:w-full"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</aside>

<script>
  const btn = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('nav-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const middle = document.getElementById('hamburger-middle');
  const drawerLinks = document.querySelectorAll('.nav-drawer-link');

  function openDrawer() {
    drawer?.setAttribute('data-open', '');
    drawer?.classList.remove('translate-x-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    middle?.classList.add('-translate-x-1/2');
  }

  function closeDrawer() {
    drawer?.removeAttribute('data-open');
    drawer?.classList.add('translate-x-full');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    middle?.classList.remove('-translate-x-1/2');
  }

  btn?.addEventListener('click', () => {
    if (drawer?.hasAttribute('data-open')) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  backdrop?.addEventListener('click', closeDrawer);

  drawerLinks.forEach((link) => {
    link.addEventListener('click', closeDrawer);
  });

  const allNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link], .nav-drawer-link');

  function setActiveLink(sectionId: string) {
    allNavLinks.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${sectionId}`;
      link.classList.toggle('text-primary', isActive);
      link.classList.toggle('text-on-background', !isActive);
    });
  }

  const sectionIds = ['home', 'about', 'projects', 'contact'];
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActiveLink(entry.target.id);
        }
      });
    },
    { rootMargin: '-40% 0px -40% 0px', threshold: 0 },
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
