---
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, shortDescription, technologies, imageUrl, imageAlt } = project;
---

<article
  class="project-card hard-shadow-hover h-full flex flex-col"
  style="--hard-shadow-offset: 6px"
>
  <button
    class="project-card__trigger"
    data-project={JSON.stringify(project)}
    aria-haspopup="dialog"
  >
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={imageAlt}
          class="w-full aspect-[4/3] object-cover rounded-t-xl"
        />
      ) : (
        <div
          role="img"
          aria-label={imageAlt}
          class="w-full aspect-[4/3] bg-surface-container-high rounded-t-xl flex items-center justify-center"
        >
          <span class="text-on-surface-variant text-sm">Image coming soon</span>
        </div>
      )
    }

    <div class="project-card__body">
      <h3 class="font-display text-xl font-bold text-on-background mb-2">{title}</h3>
      <p class="text-sm text-on-surface-variant mb-4 line-clamp-2">
        {shortDescription}
      </p>
      <ul class="flex flex-wrap gap-2 mt-auto" aria-label="Technologies">
        {
          technologies.map((tech) => (
            <li class="px-2 py-1 text-xs rounded-md bg-surface-container-high text-on-surface-variant">
              {tech}
            </li>
          ))
        }
      </ul>
    </div>
  </button>
</article>

<style>
  .project-card {
    border: 2px solid var(--color-outline-variant);
    background-color: var(--color-surface-container);
    border-radius: 1rem;
    overflow: hidden;
  }

  .project-card__trigger {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .project-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 1rem 1.25rem 1.25rem;
  }
</style>
