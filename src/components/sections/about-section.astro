---
import BandHeading from '@components/BandHeading.astro';
import Button from '@components/Button.astro';
import Reveal from '@components/Reveal.astro';
import Section from '@components/Section.astro';
import SectionTitle from '@components/SectionTitle.astro';
import StatCard from '@components/StatCard.astro';
import TriStripe from '@components/TriStripe.astro';
import { commercialProjects, sideProjects } from '../../data/projects';
import astroIcon from '../../assets/icons/astro-icon.svg';
import drizzleIcon from '../../assets/icons/drizzle-icon.svg';
import nextjsIcon from '../../assets/icons/nextjs-icon.svg';
import nodejsIcon from '../../assets/icons/nodejs-icon.svg';
import payloadIcon from '../../assets/icons/payload-icon.svg';
import postgresqlIcon from '../../assets/icons/postgresql-icon.svg';
import prismaIcon from '../../assets/icons/prisma-icon.svg';
import reactIcon from '../../assets/icons/react-icon.svg';
import reactNativeIcon from '../../assets/icons/reactnative-icon.svg';
import remixIcon from '../../assets/icons/remix-icon.svg';
import strapiIcon from '../../assets/icons/strapi-icon.svg';
import typescriptIcon from '../../assets/icons/typescript-icon.svg';

const technologies = [
  { name: 'React', icon: reactIcon },
  { name: 'Next.js', icon: nextjsIcon },
  { name: 'React Native', icon: reactNativeIcon },
  { name: 'TypeScript', icon: typescriptIcon },
  { name: 'Astro', icon: astroIcon, darkTile: true },
  { name: 'Remix', icon: remixIcon },
  { name: 'Strapi', icon: strapiIcon },
  { name: 'Payload', icon: payloadIcon },
  { name: 'Prisma', icon: prismaIcon },
  { name: 'Drizzle', icon: drizzleIcon, darkTile: true },
  { name: 'Node.js', icon: nodejsIcon },
  { name: 'PostgreSQL', icon: postgresqlIcon },
];

const marqueeItems = [...technologies, ...technologies];

const yearsOfExperience = 4;
const projectCount = commercialProjects.length + sideProjects.length;

interface AboutItem {
  title: string;
  description: string;
}

const capabilities: AboutItem[] = [
  {
    title: 'APIs & data models',
    description:
      'Schemas and endpoints that stay fast and maintainable as the product grows.',
  },
  {
    title: 'Advanced filtering & segmentation',
    description:
      'Complex query and segmentation logic that goes well beyond standard CRUD.',
  },
  {
    title: 'Role-based access control',
    description:
      'Permission systems that put the right data in front of the right people.',
  },
  {
    title: 'Responsive, user-focused interfaces',
    description:
      'Web and mobile UIs built with React and React Native that feel natural on any screen.',
  },
];

const principles: AboutItem[] = [
  {
    title: 'Fit over trends',
    description: 'I pick tools for the problem, not the hype.',
  },
  {
    title: 'Root cause over quick fix',
    description:
      'Understanding problems fully leads to stable systems and clearer code.',
  },
  {
    title: 'AI-driven, pragmatic',
    description:
      'I use tools like Claude Code to iterate faster, and keep only what works.',
  },
];
---

<Section id="about">
  <article aria-labelledby="about-heading" class="py-8 px-6 md:px-12">
    <Reveal>
      <SectionTitle title="About Me" id="about-heading" />
    </Reveal>

    <div class="flex flex-col gap-16 md:gap-28">
      {/* Band 1 — intro. Full width until the profile photo exists (Phase 5). */}
      <Reveal class="max-w-4xl">
        <p
          class="font-display text-2xl sm:text-4xl md:text-5xl leading-tight text-on-background mb-6"
        >
          I build web and mobile apps that hold up in the real world, from data
          model to interface.
        </p>
        <p class="text-lg md:text-xl text-on-surface-variant max-w-3xl">
          Fullstack Developer with {yearsOfExperience} years of commercial
          experience. I work across the entire stack, often taking ownership of
          key areas, and choose tools based on fit rather than trends.
        </p>
      </Reveal>

      {/* Band 2 — stats. */}
      <Reveal class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <StatCard value={`${yearsOfExperience}+`} label="Years Experience" />
        <StatCard value={`${projectCount}+`} label="Projects Delivered" />
        <StatCard value="1" label="npm Package Published" />
      </Reveal>

      {/* Band 3 — what I do. Tiles bleed to the article edge on mobile,
          matching the project rows in projects-section.astro. */}
      <section aria-labelledby="about-capabilities-heading">
        <Reveal>
          <BandHeading id="about-capabilities-heading" title="What I do" />
        </Reveal>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 -mx-6 md:mx-0">
          {
            capabilities.map((capability, index) => (
              <li>
                <Reveal delay={(index + 1) * 75} class="h-full">
                  <div class="about-tile h-full">
                    <h4 class="font-display text-xl text-on-background mb-2">
                      {capability.title}
                    </h4>
                    <p class="text-base text-on-surface-variant">
                      {capability.description}
                    </p>
                  </div>
                </Reveal>
              </li>
            ))
          }
        </ul>
      </section>

      {/* Band 4 — open source. The card itself isn't a link, so npm and
          GitHub can be two sibling links instead of one nested in another. */}
      <section aria-labelledby="about-oss-heading">
        <Reveal>
          <BandHeading id="about-oss-heading" title="Open source" />
        </Reveal>
        <Reveal delay={75} class="-mx-6 md:mx-0">
          <div class="oss-card">
            <p class="text-base text-on-surface-variant mb-1">
              Lead programmer
            </p>
            <code
              class="block text-on-background font-mono text-lg sm:text-xl md:text-2xl mb-2 break-all"
              >@bitnoi.se/react-scheduler</code
            >
            <p class="text-base md:text-lg text-on-background mb-6">
              Open-source React scheduling component, built to be reused well
              beyond a single project.
            </p>
            <div class="flex flex-wrap gap-3">
              <Button
                href="https://www.npmjs.com/package/@bitnoi.se/react-scheduler"
                target="_blank"
                variant="primary"
                icon="↗"
                iconPosition="right"
                ariaLabel="@bitnoi.se/react-scheduler on npm"
              >
                npm
              </Button>
              <Button
                href="https://github.com/Bitnoise/react-scheduler"
                target="_blank"
                variant="secondary"
                icon="↗"
                iconPosition="right"
                ariaLabel="@bitnoi.se/react-scheduler on GitHub"
              >
                GitHub
              </Button>
            </div>
          </div>
        </Reveal>
      </section>

      {/* Band 5 — how I work. */}
      <section aria-labelledby="about-principles-heading">
        <Reveal>
          <BandHeading id="about-principles-heading" title="How I work" />
        </Reveal>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            principles.map((principle, index) => (
              <li>
                <Reveal delay={(index + 1) * 75}>
                  <TriStripe class="h-1 w-10 mb-4" />
                  <h4 class="font-display text-2xl text-on-background mb-2">
                    {principle.title}
                  </h4>
                  <p class="text-base text-on-surface-variant">
                    {principle.description}
                  </p>
                </Reveal>
              </li>
            ))
          }
        </ul>
      </section>

      {/* Band 6 — technologies. */}
      <section aria-labelledby="about-tech-heading">
        <Reveal>
          <BandHeading id="about-tech-heading" title="Technologies" />
        </Reveal>
        <Reveal delay={75}>
          <div class="overflow-hidden marquee-fade">
            <div class="flex animate-marquee gap-12 w-max" aria-hidden="true">
              {
                marqueeItems.map((tech) => (
                  <div class="flex flex-col items-center gap-2 shrink-0">
                    {tech.icon ? (
                      <div
                        class:list={[
                          'size-20 rounded-xl flex items-center justify-center p-2.5',
                          tech.darkTile
                            ? 'bg-inverse-surface'
                            : 'bg-surface-container',
                        ]}
                      >
                        <img
                          src={tech.icon.src}
                          alt=""
                          class="size-full object-contain"
                        />
                      </div>
                    ) : (
                      <div
                        role="img"
                        aria-label={`${tech.name} icon coming soon`}
                        class="size-20 bg-surface-container rounded-xl flex items-center justify-center text-on-surface-variant text-xs text-center px-1"
                      >
                        SVG
                      </div>
                    )}
                    <span class="text-sm text-on-surface-variant">
                      {tech.name}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </Reveal>
      </section>
    </div>
  </article>
</Section>

<style>
  .about-tile {
    border: 2px solid var(--color-outline-variant);
    background-color: var(--color-surface-container);
    border-radius: 1rem;
    padding: 1.25rem 1rem;
  }

  .oss-card {
    border: 2px solid var(--color-outline-variant);
    background-color: var(--color-surface-container);
    border-radius: 1rem;
    padding: 1.5rem 1rem;
  }

  /* Mobile padding matches .project-row (ProjectListRow.astro), since both
     bleed to the article edge below md. */
  @media (min-width: 48rem) {
    .about-tile {
      padding: 1.5rem;
    }

    .oss-card {
      padding: 2rem 2.5rem;
    }
  }

  .marquee-fade {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }
</style>

<script>
  import { observeCountUp } from 'utils/count';

  observeCountUp('.stat-card__value');
</script>
