---
import Reveal from '@components/Reveal.astro';
import Section from '@components/Section.astro';
import SectionTitle from '@components/SectionTitle.astro';
import StatCard from '@components/StatCard.astro';
import { commercialProjects, sideProjects } from '../../data/projects';
import astroIcon from '../../assets/icons/astro-icon.svg';
import drizzleIcon from '../../assets/icons/drizzle-icon.svg';
import nextjsIcon from '../../assets/icons/nextjs-icon.svg';
import nodejsIcon from '../../assets/icons/nodejs-icon.svg';
import payloadIcon from '../../assets/icons/payload-icon.svg';
import postgresqlIcon from '../../assets/icons/postgresql-icon.svg';
import prismaIcon from '../../assets/icons/prisma-icon.svg';
import reactIcon from '../../assets/icons/react-icon.svg';
import reactNativeIcon from '../../assets/icons/reactnative-icon.svg';
import remixIcon from '../../assets/icons/remix-icon.svg';
import strapiIcon from '../../assets/icons/strapi-icon.svg';
import typescriptIcon from '../../assets/icons/typescript-icon.svg';

const technologies = [
  { name: 'React', icon: reactIcon },
  { name: 'Next.js', icon: nextjsIcon },
  { name: 'React Native', icon: reactNativeIcon },
  { name: 'TypeScript', icon: typescriptIcon },
  { name: 'Astro', icon: astroIcon, darkTile: true },
  { name: 'Remix', icon: remixIcon },
  { name: 'Strapi', icon: strapiIcon },
  { name: 'Payload', icon: payloadIcon },
  { name: 'Prisma', icon: prismaIcon },
  { name: 'Drizzle', icon: drizzleIcon, darkTile: true },
  { name: 'Node.js', icon: nodejsIcon },
  { name: 'PostgreSQL', icon: postgresqlIcon },
];

const marqueeItems = [...technologies, ...technologies];

const projectCount = commercialProjects.length + sideProjects.length;

const capabilities = [
  'Designing APIs & data models',
  'Advanced filtering & segmentation systems',
  'Role-based access control',
  'Responsive, user-focused interfaces',
];
---

<Section
  id="about"
  activeBars={{
    position: ['horizontal', 'right'],
    options: { offset: ['left'], invertColor: ['right'] },
  }}
  activeConnectors={{ position: ['top-right'] }}
>
  <article aria-labelledby="about-heading" class="py-8 px-6 md:px-12">
    <Reveal>
      <SectionTitle title="About Me" id="about-heading" />
    </Reveal>

    <Reveal class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      <StatCard value="4+" label="Years Experience" />
      <StatCard value={`${projectCount}+`} label="Projects Delivered" />
      <StatCard value="1" label="npm Package Published" />
    </Reveal>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <Reveal class="md:col-span-2 space-y-4 text-xl text-on-background">
        <p>
          I'm a Fullstack Developer with 4 years of commercial experience,
          building web and mobile applications with a focus on real-world
          usability and solid architecture. I work across the entire stack,
          taking ownership of key areas along the way:
        </p>

        <ul class="flex flex-col gap-3 text-lg">
          {capabilities.map((point, index) => (
            <li class="flex items-start gap-3">
              <span class="font-display flex size-6 shrink-0 items-center justify-center rounded bg-primary text-xs font-bold text-on-primary mt-0.5">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <p>
          My core stack includes React, Next.js, React Native, and
          TypeScript, supported by Strapi, Payload, Prisma, and Drizzle —
          I've worked with multiple frameworks across several <a
            href="#projects"
            class="projects-link">projects</a
          > of varying complexity and choose tools based on fit rather than trends.
        </p>

        <a
          href="https://www.npmjs.com/package/@bitnoi.se/react-scheduler"
          target="_blank"
          rel="noopener noreferrer"
          class="npm-card hard-shadow-hover block"
          style="--hard-shadow-offset: 5px"
          aria-label="@bitnoi.se/react-scheduler on npm"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-base text-on-surface-variant mb-1">
                Lead programmer
              </p>
              <code class="text-primary font-mono text-lg"
                >@bitnoi.se/react-scheduler</code
              >
            </div>
            <span class="text-on-surface-variant text-sm shrink-0 mt-1"
              >↗ npm</span
            >
          </div>
          <div class="flex gap-3 mt-3">
            <a
              href="https://github.com/Bitnoise/react-scheduler"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-on-surface-variant hover:text-primary transition-colors"
              onclick="event.stopPropagation()"
            >
              GitHub ↗
            </a>
            <span class="text-outline-variant">·</span>
            <span class="text-sm text-on-surface-variant">
              Open-source React scheduling component
            </span>
          </div>
        </a>

        <p>
          I'm AI-driven in my workflow and stay pragmatic about new
          technologies — I adopt what works and discard what doesn't. I focus
          on understanding problems at their root, which leads to more stable
          systems and clearer code.
        </p>
      </Reveal>

      <Reveal delay={150} class="md:col-span-1 flex items-start justify-center">
        <div class="relative w-full">
          <div
            aria-hidden="true"
            class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl bg-gradient-to-br from-section-snake-outer via-section-snake-middle to-section-snake-inner"
          >
          </div>
          <div
            role="img"
            aria-label="Profile photo coming soon"
            class="relative w-full aspect-[3/4] bg-surface-container-high rounded-2xl border-2 border-outline-variant flex items-center justify-center"
          >
            <span class="font-display text-xl text-on-background text-center px-4">
              Photo coming soon
            </span>
          </div>
        </div>
      </Reveal>
    </div>

    <Reveal delay={200} class="mt-12">
      <section aria-label="Technologies">
        <h3 class="font-display text-3xl text-on-background font-bold mb-6">Technologies</h3>
        <div class="overflow-hidden marquee-fade">
          <div class="flex animate-marquee gap-12 w-max" aria-hidden="true">
            {
              marqueeItems.map((tech) => (
                <div class="flex flex-col items-center gap-2 shrink-0">
                  {tech.icon ? (
                    <div
                      class:list={[
                        'size-20 rounded-xl flex items-center justify-center p-2.5',
                        tech.darkTile
                          ? 'bg-inverse-surface'
                          : 'bg-surface-container',
                      ]}
                    >
                      <img
                        src={tech.icon.src}
                        alt=""
                        class="size-full object-contain"
                      />
                    </div>
                  ) : (
                    <div
                      role="img"
                      aria-label={`${tech.name} icon coming soon`}
                      class="size-20 bg-surface-container rounded-xl flex items-center justify-center text-on-surface-variant text-xs text-center px-1"
                    >
                      SVG
                    </div>
                  )}
                  <span class="text-sm text-on-surface-variant">
                    {tech.name}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </Reveal>
  </article>
</Section>

<style>
  .projects-link {
    background-image: linear-gradient(
      var(--color-section-snake-inner),
      var(--color-section-snake-inner)
    );
    font-weight: 600;
    background-size: 0% 100%;
    background-position: left center;
    background-repeat: no-repeat;
    transition: background-size 0.35s ease;
  }

  .projects-link:hover {
    background-size: 100% 100%;
    color: var(--color-on-background);
  }

  .npm-card {
    border: 2px solid var(--color-outline-variant);
    background-color: var(--color-surface-container);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
  }

  @media (hover: hover) {
    .npm-card:hover {
      background-color: var(--color-surface-container-high);
    }
  }

  .marquee-fade {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }
</style>

<script>
  import { observeCountUp } from 'utils/count';

  observeCountUp('.stat-card__value');
</script>
