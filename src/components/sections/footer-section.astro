---
import Reveal from '@components/Reveal.astro';
import Section from '@components/Section.astro';
import SectionTitle from '@components/SectionTitle.astro';

const contacts = [
  { label: 'Email', value: 'codemeinpn@gmail.com', href: 'mailto:codemeinpn@gmail.com' },
  { label: 'Phone', value: '+48 531 518 260', href: 'tel:+48531518260' },
  { label: 'GitHub', value: 'CodeMeInPn', href: 'https://github.com/CodeMeInPn' },
  { label: 'LinkedIn', value: 'codemein', href: 'https://www.linkedin.com/in/codemein' },
];
---

<Section
  id="contact"
  activeBars={{
    position: ['horizontal', 'right'],
    options: { offset: ["left", "top", "top-vertical"], invertColor: ["right"] },
  }}
  activeConnectors={{ position: ['top-right', "bottom-left-inverted"], "offset": ["top-right"] }}
>
  <article aria-labelledby="contact-heading" class="py-8 px-6 md:px-12">
    <Reveal>
      <SectionTitle title="Contact" id="contact-heading" />
    </Reveal>

    <Reveal delay={75}>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6 max-w-xl">
        {
          contacts.map(({ label, value, href }) => (
            <div>
              <p class="text-sm text-on-surface-variant mb-1">{label}</p>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="text-lg text-on-background hover:text-primary transition-colors duration-200"
              >
                {value}
              </a>
            </div>
          ))
        }
      </div>
    </Reveal>
  </article>
</Section>
