---
import ProjectCard from '@components/ProjectCard.astro';
import ProjectModal from '@components/ProjectModal.astro';
import Reveal from '@components/Reveal.astro';
import Section from '@components/Section.astro';
import SectionTitle from '@components/SectionTitle.astro';
import { commercialProjects, sideProjects } from '../../data/projects';
---

<Section
  id="projects"
  activeBars={{
    position: ['horizontal', 'left'],
    options: { offset: ['top', 'right'], invertColor: ['top', 'left'] },
  }}
  activeConnectors={{
    position: ['bottom-left', 'bottom-right'],
    offset: ['bottom-left'],
  }}
>
  <article aria-labelledby="projects-heading" class="py-8 px-6 md:px-12">
    <Reveal>
      <SectionTitle title="Projects" id="projects-heading" />
    </Reveal>

    <section aria-labelledby="commercial-heading">
      <Reveal delay={75}>
        <h3
          id="commercial-heading"
          class="font-display text-3xl text-on-background font-bold mb-6"
        >
          Commercial
        </h3>
      </Reveal>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          commercialProjects.map((project, index) => (
            <Reveal delay={(index + 1) * 75} class="h-full">
              <ProjectCard project={project} />
            </Reveal>
          ))
        }
      </div>
    </section>

    {
      sideProjects.length > 0 && (
        <section aria-labelledby="side-heading" class="mt-12">
          <Reveal delay={(commercialProjects.length + 1) * 75}>
            <h3 id="side-heading" class="font-display text-3xl text-on-background font-bold mb-6">
              Side Projects
            </h3>
          </Reveal>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {sideProjects.map((project, index) => (
              <Reveal delay={(commercialProjects.length + index + 2) * 75} class="h-full">
                <ProjectCard project={project} />
              </Reveal>
            ))}
          </div>
        </section>
      )
    }

    <ProjectModal />
  </article>
</Section>
