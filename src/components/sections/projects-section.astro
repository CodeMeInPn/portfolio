---
import ProjectCard from '@components/ProjectCard.astro';
import ProjectModal from '@components/ProjectModal.astro';
import Reveal from '@components/Reveal.astro';
import Section from '@components/Section.astro';
import { commercialProjects, sideProjects } from '../../data/projects';
---

<Section
  id="projects"
  activeBars={{
    position: ['horizontal', 'vertical-left'],
    options: { offset: ['top', 'right'], invertColor: ['top', 'left'] },
  }}
  activeConnectors={{
    position: ['bottom-left', 'bottom-right'],
    offset: ['bottom-left'],
  }}
>
  <article aria-labelledby="projects-heading" class="py-12 px-6 md:px-12">
    <Reveal>
      <h2
        id="projects-heading"
        class="text-5xl md:text-7xl text-primary font-bold mb-3"
      >
        Projects
      </h2>
      <div class="flex h-1 w-20 mb-10">
        <div class="flex-1 bg-section-snake-outer"></div>
        <div class="flex-1 bg-section-snake-middle"></div>
        <div class="flex-1 bg-section-snake-inner"></div>
      </div>
    </Reveal>

    <section aria-labelledby="commercial-heading">
      <Reveal delay={75}>
        <h3
          id="commercial-heading"
          class="text-3xl text-primary font-bold mb-6"
        >
          Commercial
        </h3>
      </Reveal>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          commercialProjects.map((project, index) => (
            <Reveal delay={(index + 1) * 75}>
              <ProjectCard project={project} />
            </Reveal>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="side-heading" class="mt-12">
      <Reveal delay={(commercialProjects.length + 1) * 75}>
        <h3 id="side-heading" class="text-3xl text-primary font-bold mb-6">
          Side Projects
        </h3>
      </Reveal>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          sideProjects.map((project, index) => (
            <Reveal delay={(commercialProjects.length + index + 2) * 75}>
              <ProjectCard project={project} />
            </Reveal>
          ))
        }
      </div>
    </section>

    <ProjectModal />
  </article>
</Section>
