---
import Button from '@components/Button.astro';
import Reveal from '@components/Reveal.astro';

const flapWords = ['React', 'Next.js', 'React Native', 'TypeScript'];

type Pt = { x: number; y: number };

// The ribbon's centerline "spine": enters horizontally from the left edge,
// twists counterclockwise in the top-right corner, exits straight down.
function buildSpine(): Pt[] {
  const points: Pt[] = [];

  // Center/radius chosen so the whole (thick) ribbon clears both the fixed
  // navbar above and the centered name/tagline block below. The bundle is
  // 4 stripes wide (20 spacing + 10 half-width = 50 either side of the
  // spine), so the loop radius must stay above ~50 to avoid the offset
  // stripes crossing themselves at the tightest point.
  const center = { x: 1060, y: 128 };
  const radius = 65;
  const entryY = center.y + radius;
  const thetaStart = 90; // degrees; bottom of the circle
  const sweep = 270; // degrees, decreasing = visually counterclockwise

  const hSteps = 50;
  for (let i = 0; i <= hSteps; i++) {
    const t = i / hSteps;
    points.push({ x: t * center.x, y: entryY });
  }

  const loopSteps = 120;
  for (let i = 1; i <= loopSteps; i++) {
    const t = i / loopSteps;
    const theta = ((thetaStart - t * sweep) * Math.PI) / 180;
    points.push({
      x: center.x + radius * Math.cos(theta),
      y: center.y + radius * Math.sin(theta),
    });
  }

  const exitX = points[points.length - 1].x;
  const exitY = points[points.length - 1].y;
  // Runs past the viewBox's bottom edge (640) so it gets clipped flat by
  // the SVG viewport, bleeding off-screen the same way the left edge does,
  // instead of showing a rounded cap floating above the bottom.
  const bottomY = 700;
  const vSteps = 60;
  for (let i = 1; i <= vSteps; i++) {
    const t = i / vSteps;
    points.push({ x: exitX, y: exitY + t * (bottomY - exitY) });
  }

  return points;
}

function computeNormals(points: Pt[]): Pt[] {
  return points.map((_, i) => {
    const prev = points[Math.max(0, i - 1)];
    const next = points[Math.min(points.length - 1, i + 1)];
    const dx = next.x - prev.x;
    const dy = next.y - prev.y;
    const len = Math.hypot(dx, dy) || 1;
    return { x: -dy / len, y: dx / len };
  });
}

function offsetPoints(points: Pt[], normals: Pt[], offset: number): Pt[] {
  return points.map((p, i) => ({
    x: p.x + normals[i].x * offset,
    y: p.y + normals[i].y * offset,
  }));
}

function toPathD(points: Pt[]): string {
  return points
    .map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
    .join(' ');
}

function pathLength(points: Pt[]): number {
  let len = 0;
  for (let i = 1; i < points.length; i++) {
    len += Math.hypot(points[i].x - points[i - 1].x, points[i].y - points[i - 1].y);
  }
  return len;
}

const spine = buildSpine();
const normals = computeNormals(spine);
// Three separate parallel tracks (not nested rings), touching with no gap —
// offset sideways from the spine so each color runs its own course.
const STRIPE_WIDTH = 20;
const STRIPE_SPACING = 20;
const stripes = [
  { name: 'deepest', color: 'var(--color-section-snake-deepest)', offset: -2 * STRIPE_SPACING, delay: '0s' },
  { name: 'outer', color: 'var(--color-section-snake-outer)', offset: -STRIPE_SPACING, delay: '0.25s' },
  { name: 'middle', color: 'var(--color-section-snake-middle)', offset: 0, delay: '0.5s' },
  { name: 'inner', color: 'var(--color-section-snake-inner)', offset: STRIPE_SPACING, delay: '0.75s' },
].map((s) => {
  const pts = offsetPoints(spine, normals, s.offset);
  const length = pathLength(pts);
  return { ...s, d: toPathD(pts), length: length.toFixed(0) };
});

const techFlowWords = [
  'React',
  'Next.js',
  'React Native',
  'TypeScript',
  'Node.js',
  'PostgreSQL',
  'Astro',
  'Tailwind CSS',
];

// Distribute words round-robin across the 3 stripes (not all 8 on every
// stripe) so each stripe only carries 2-3 words — evenly spaced along the
// path at build time, so words can never drift into overlapping each other.
const wordInstances = stripes.flatMap((s, si) => {
  const group = techFlowWords.filter((_, wi) => wi % stripes.length === si);
  return group.map((word, i) => ({
    stripeName: s.name,
    word,
    index: i,
    groupSize: group.length,
  }));
});
---

<section class="relative">
  <div
    class="relative isolate min-h-[calc(100vh-4rem)] w-full flex items-center justify-center py-16 overflow-hidden"
  >
    <svg
      class="hero-snake absolute inset-0 -z-10 w-full h-full"
      viewBox="0 0 1200 640"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <linearGradient
          id="hero-snake-bottom-fade-grad"
          x1="0"
          y1="500"
          x2="0"
          y2="640"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#fff" />
          <stop offset="1" stop-color="#000" />
        </linearGradient>
        <linearGradient
          id="hero-snake-left-fade-grad"
          x1="0"
          y1="0"
          x2="120"
          y2="0"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#fff" />
        </linearGradient>
        <mask
          id="hero-snake-bottom-fade"
          maskUnits="userSpaceOnUse"
          x="-100"
          y="-100"
          width="1400"
          height="840"
        >
          <rect x="-100" y="-100" width="1400" height="600" fill="#fff" />
          <rect
            x="-100"
            y="500"
            width="1400"
            height="240"
            fill="url(#hero-snake-bottom-fade-grad)"
          />
          <rect
            x="-100"
            y="-100"
            width="220"
            height="840"
            fill="url(#hero-snake-left-fade-grad)"
          />
        </mask>
      </defs>

      <g mask="url(#hero-snake-bottom-fade)">
        {
          stripes.map((s) => (
            <path
              id={`hero-snake-band-${s.name}`}
              class="hero-snake__band"
              d={s.d}
              fill="none"
              stroke={s.color}
              stroke-width={STRIPE_WIDTH}
              stroke-linecap="round"
              pathLength={s.length}
              style={`stroke-dasharray:${s.length}; --reveal-length:${s.length}; animation-delay:${s.delay}`}
            />
          ))
        }
      </g>

      {
        wordInstances.map((w) => (
          <text
            class="hero-snake__word"
            data-index={w.index}
            data-group-size={w.groupSize}
          >
            <textPath
              class="hero-snake__wordpath"
              href={`#hero-snake-band-${w.stripeName}`}
              startOffset="0"
            >
              {w.word}
            </textPath>
          </text>
        ))
      }
    </svg>

    <div
      class="max-w-content-hero mx-auto px-4 md:px-8 relative z-10 mt-28 flex flex-col items-center text-center gap-6"
    >
      {/* Delays start after the ribbon's reveal finishes (last stripe's
          0.75s animation-delay + 3s duration = 3.75s), then keep the same
          150ms stagger between name/tagline/buttons as before. */}
      <Reveal delay={3750}>
        <div class="hero-name-wrap">
          <span
            class="hero-name-shadow font-display text-6xl md:text-8xl"
            aria-hidden="true"
          >
            Piotr Nowak
          </span>
          <h1
            class="hero-name font-display text-6xl md:text-8xl text-on-background"
          >
            Piotr Nowak
          </h1>
        </div>
      </Reveal>

      <Reveal delay={3900}>
        <p
          class="text-lg md:text-xl text-on-background max-w-xl flex flex-wrap items-center justify-center gap-x-2 gap-y-1"
        >
          <span>Fullstack Developer —</span>
          <span class="hero-flap">
            {
              flapWords.map((word, i) => (
                <span
                  class="hero-flap__word"
                  style={`animation-delay: ${i * 2}s`}
                >
                  {word}
                </span>
              ))
            }
          </span>
          <span class="sr-only">
            React, Next.js, React Native, and TypeScript
          </span>
        </p>
      </Reveal>

      <Reveal delay={4050}>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <Button href="#projects" variant="primary">View Projects</Button>
          <Button href="#contact" variant="tertiary">Get in Touch</Button>
        </div>
      </Reveal>
    </div>

    <div
      aria-hidden="true"
      class="hero-scroll-cue absolute bottom-4 left-1/2 -translate-x-1/2 text-on-background/60"
    >
      <svg
        width="42"
        height="42"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 15C5 16.8565 5.73754 18.6371 7.05029 19.9498C8.36305 21.2626 10.1435 21.9999 12 21.9999C13.8565 21.9999 15.637 21.2626 16.9498 19.9498C18.2625 18.6371 19 16.8565 19 15V9C19 7.14348 18.2625 5.36305 16.9498 4.05029C15.637 2.73754 13.8565 2 12 2C10.1435 2 8.36305 2.73754 7.05029 4.05029C5.73754 5.36305 5 7.14348 5 9V15Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M12 6V14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M15 11L12 14L9 11"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Poster-print misregistration effect on the name */
  .hero-name-wrap {
    position: relative;
    display: inline-block;
  }

  .hero-name-shadow {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: translate(0.4rem, 0.4rem);
    background-image: linear-gradient(
      90deg,
      var(--color-section-snake-deepest),
      var(--color-section-snake-outer),
      var(--color-section-snake-middle),
      var(--color-section-snake-inner)
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
    user-select: none;
  }

  .hero-name {
    position: relative;
    z-index: 1;
  }

  /* Drop-and-bounce word cycle */
  .hero-flap {
    position: relative;
    display: inline-block;
    height: 1.3em;
    min-width: 13ch;
    vertical-align: bottom;
    overflow: hidden;
    text-align: left;
  }

  .hero-flap__word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-160%);
    animation: hero-flap-cycle 8s linear infinite both;
  }

  /*
   * Each keyframe sets animation-timing-function for the segment that
   * FOLLOWS it, so the bounce is built from per-segment easing rather than
   * stacking a second overshoot on top of an already-elastic curve:
   * drop in fast (ease-out) -> overshoot past rest -> settle back up
   * (ease-in-out) -> hold -> fall out and fade (ease-in).
   */
  @keyframes hero-flap-cycle {
    0% {
      opacity: 0;
      transform: translateY(-160%);
      animation-timing-function: ease-out;
    }
    3% {
      opacity: 1;
      transform: translateY(12%);
      animation-timing-function: ease-in-out;
    }
    5% {
      transform: translateY(-5%);
      animation-timing-function: ease-out;
    }
    7% {
      opacity: 1;
      transform: translateY(0%);
      animation-timing-function: linear;
    }
    20% {
      opacity: 1;
      transform: translateY(0%);
      animation-timing-function: ease-in;
    }
    25%,
    100% {
      opacity: 0;
      transform: translateY(130%);
    }
  }

/* Groovy 70s parallel-stripe ribbon */
  .hero-snake__band {
    opacity: 0.85;
    animation: hero-snake-reveal 3s ease-out both;
  }

  @keyframes hero-snake-reveal {
    from {
      stroke-dashoffset: var(--reveal-length);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-snake__word {
    fill: #ffffff;
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 0.03em;
    dominant-baseline: central;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .hero-scroll-cue {
    animation: hero-scroll-bounce 2.4s ease-in-out infinite;
  }

  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateX(-50%) translateY(0.4rem);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-flap__word,
    .hero-snake__band,
    .hero-scroll-cue {
      animation: none;
    }

    .hero-flap__word:first-child {
      opacity: 1;
      transform: translateY(0%);
    }

    .hero-snake__band {
      stroke-dashoffset: 0;
    }

    .hero-snake__word {
      opacity: 0;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  const wordPaths = Array.from(
    document.querySelectorAll<SVGTextPathElement>('.hero-snake__wordpath'),
  );

  if (!prefersReducedMotion) {
    const FADE_MARGIN = 0.08; // fraction of path length spent fading in/out

    // Same speed for every word so relative spacing within a stripe's group
    // never drifts — only the starting position varies, so words can never
    // catch up to and overlap each other.
    const SPEED = 60;

    const runners = wordPaths
      .map((textPath) => {
        const href = textPath.getAttribute('href');
        const guide = href
          ? document.querySelector<SVGGeometryElement>(href)
          : null;
        const textEl = textPath.parentElement as SVGTextElement | null;
        if (!guide || !textEl) return null;

        const length = guide.getTotalLength();
        const index = Number(textEl.dataset.index ?? 0);
        const groupSize = Number(textEl.dataset.groupSize ?? 1);
        // Evenly spaced slot within the group, plus jitter small enough
        // that it can't cross into a neighboring slot.
        const slot = (index + 0.5) / groupSize;
        const jitter = (Math.random() - 0.5) * (1 / groupSize) * 0.6;
        const offset = Math.min(1, Math.max(0, slot + jitter)) * length;

        return { textPath, textEl, length, offset };
      })
      .filter((r): r is NonNullable<typeof r> => r !== null);

    // Matches the ribbon's own reveal timing (last stripe's 0.75s
    // animation-delay + 3s duration) so words only start flowing once the
    // ribbon has finished drawing itself in.
    const RIBBON_REVEAL_MS = 3750;

    let last = performance.now();
    function tick(now: number) {
      const dt = (now - last) / 1000;
      last = now;

      for (const r of runners) {
        r.offset = (r.offset + SPEED * dt) % r.length;
        // Positive, increasing startOffset = flows left-to-right along the
        // ribbon (the horizontal entry segment moves toward +x).
        r.textPath.setAttribute('startOffset', String(r.offset));

        const frac = r.offset / r.length;
        const fadeIn = Math.min(1, frac / FADE_MARGIN);
        const fadeOut = Math.min(1, (1 - frac) / FADE_MARGIN);
        r.textEl.style.opacity = String(Math.min(fadeIn, fadeOut));
      }

      requestAnimationFrame(tick);
    }

    setTimeout(() => {
      last = performance.now();
      requestAnimationFrame(tick);
    }, RIBBON_REVEAL_MS);
  }
</script>
