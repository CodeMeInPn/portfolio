---
import { Image } from 'astro:assets';
import Button from '@components/Button.astro';
import cmiLogo from '../../assets/images/cmi-logo.png';
---

<section id="home" class="max-w-content-hero mx-auto px-4 md:px-8">
  <div
    class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center py-16 overflow-hidden"
  >
    <div
      aria-hidden="true"
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -z-10"
    >
      <div
        class="size-[24rem] md:size-[36rem] rounded-full bg-section-snake-outer opacity-15"
      >
      </div>
      <div
        class="absolute inset-[15%] rounded-full bg-section-snake-middle opacity-20"
      >
      </div>
      <div
        class="absolute inset-[32%] rounded-full bg-section-snake-inner opacity-25"
      >
      </div>
    </div>

    <div
      class="flex flex-col items-center text-center gap-6 animate-fade-in"
    >
      <div class="hidden size-32 md:size-40 relative">
        <Image
          tabindex={-1}
          class="pointer-events-none object-cover"
          src={cmiLogo}
          alt="CodeMeIn Logo"
          draggable="false"
        />
      </div>

      <div>
        <h1 class="font-display text-5xl md:text-7xl font-bold text-on-background">
          Piotr Nowak
        </h1>
        <p class="mt-3 text-lg md:text-xl text-on-background max-w-xl mx-auto">
          Fullstack Developer — React, Next.js, React Native &amp; TypeScript
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href="#projects" variant="primary">View Projects</Button>
        <Button href="#contact" variant="tertiary">Get in Touch</Button>
      </div>
    </div>
  </div>
</section>
