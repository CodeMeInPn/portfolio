---
import Button from '@components/Button.astro';
import Reveal from '@components/Reveal.astro';

const flapWords = ['React', 'Next.js', 'React Native', 'TypeScript'];
---

<section id="hero" class="relative">
  <div
    class="relative isolate min-h-[calc(100vh-4rem)] w-full flex items-center justify-center py-16 overflow-hidden"
  >
    <div
      class="max-w-content-hero mx-auto px-4 md:px-8 relative z-10 mt-28 flex flex-col items-center text-center gap-6"
    >
      {/* Kept independent of the page ribbon's own (much longer) reveal —
          the text shouldn't wait for the ribbon to finish drawing itself
          in, just stagger in shortly after the page loads. */}
      <Reveal delay={200}>
        <div class="hero-name-wrap">
          <span
            class="hero-name-shadow font-display text-6xl md:text-8xl"
            aria-hidden="true"
          >
            Piotr Nowak
          </span>
          <h1
            class="hero-name font-display text-6xl md:text-8xl text-on-background"
          >
            Piotr Nowak
          </h1>
        </div>
      </Reveal>

      <Reveal delay={350}>
        <p
          class="text-lg md:text-xl text-on-background max-w-xl flex flex-wrap items-center justify-center gap-x-2 gap-y-1"
        >
          <span>Fullstack Developer —</span>
          <span class="hero-flap">
            {
              flapWords.map((word, i) => (
                <span
                  class="hero-flap__word"
                  style={`animation-delay: ${i * 2}s`}
                >
                  {word}
                </span>
              ))
            }
          </span>
          <span class="sr-only">
            React, Next.js, React Native, and TypeScript
          </span>
        </p>
      </Reveal>

      <Reveal delay={500}>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <Button href="#projects" variant="primary">View Projects</Button>
          <Button href="#contact" variant="tertiary">Get in Touch</Button>
        </div>
      </Reveal>
    </div>

    <div
      aria-hidden="true"
      class="hero-scroll-cue absolute bottom-4 left-1/2 -translate-x-1/2 text-on-background/60"
    >
      <svg
        width="42"
        height="42"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 15C5 16.8565 5.73754 18.6371 7.05029 19.9498C8.36305 21.2626 10.1435 21.9999 12 21.9999C13.8565 21.9999 15.637 21.2626 16.9498 19.9498C18.2625 18.6371 19 16.8565 19 15V9C19 7.14348 18.2625 5.36305 16.9498 4.05029C15.637 2.73754 13.8565 2 12 2C10.1435 2 8.36305 2.73754 7.05029 4.05029C5.73754 5.36305 5 7.14348 5 9V15Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M12 6V14"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
        <path
          d="M15 11L12 14L9 11"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Poster-print misregistration effect on the name */
  .hero-name-wrap {
    position: relative;
    display: inline-block;
  }

  .hero-name-shadow {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform: translate(0.4rem, 0.4rem);
    background-image: linear-gradient(
      90deg,
      var(--color-section-snake-deepest),
      var(--color-section-snake-outer),
      var(--color-section-snake-middle),
      var(--color-section-snake-inner)
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
    user-select: none;
  }

  .hero-name {
    position: relative;
    z-index: 1;
  }

  /* Drop-and-bounce word cycle */
  .hero-flap {
    position: relative;
    display: inline-block;
    height: 1.3em;
    min-width: 13ch;
    vertical-align: bottom;
    overflow: hidden;
    text-align: left;
  }

  .hero-flap__word {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-160%);
    animation: hero-flap-cycle 8s linear infinite both;
  }

  /*
   * Each keyframe sets animation-timing-function for the segment that
   * FOLLOWS it, so the bounce is built from per-segment easing rather than
   * stacking a second overshoot on top of an already-elastic curve:
   * drop in fast (ease-out) -> overshoot past rest -> settle back up
   * (ease-in-out) -> hold -> fall out and fade (ease-in).
   */
  @keyframes hero-flap-cycle {
    0% {
      opacity: 0;
      transform: translateY(-160%);
      animation-timing-function: ease-out;
    }
    3% {
      opacity: 1;
      transform: translateY(12%);
      animation-timing-function: ease-in-out;
    }
    5% {
      transform: translateY(-5%);
      animation-timing-function: ease-out;
    }
    7% {
      opacity: 1;
      transform: translateY(0%);
      animation-timing-function: linear;
    }
    20% {
      opacity: 1;
      transform: translateY(0%);
      animation-timing-function: ease-in;
    }
    25%,
    100% {
      opacity: 0;
      transform: translateY(130%);
    }
  }

  .hero-scroll-cue {
    animation: hero-scroll-bounce 2.4s ease-in-out infinite;
  }

  @keyframes hero-scroll-bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateX(-50%) translateY(0.4rem);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-flap__word,
    .hero-scroll-cue {
      animation: none;
    }

    .hero-flap__word:first-child {
      opacity: 1;
      transform: translateY(0%);
    }
  }
</style>
