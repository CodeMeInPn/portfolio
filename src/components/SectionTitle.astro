---
import TriStripe from '@components/TriStripe.astro';

interface Props {
  title: string;
  id?: string;
  tag?: 'h1' | 'h2';
}

const { title, id, tag = 'h2' } = Astro.props;
const Tag = tag;
---

<Tag id={id} class="font-display text-5xl md:text-7xl text-on-background mb-3">
  {title}
</Tag>
<TriStripe class="h-1 w-20 mb-10" />
