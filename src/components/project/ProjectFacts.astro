---
import BandHeading from '@components/BandHeading.astro';
import ProjectStatStrip from './ProjectStatStrip.astro';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { stats } = project;
---

{
  stats && stats.length > 0 && (
    <section id="facts" aria-labelledby="facts-heading">
      <BandHeading title="Featured Facts" id="facts-heading" level="h2" />
      <ProjectStatStrip stats={stats} />
    </section>
  )
}

<script>
  import { observeCountUp } from 'utils/count';

  observeCountUp('.stat-strip__value');
</script>
