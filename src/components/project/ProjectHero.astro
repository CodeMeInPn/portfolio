---
import Button from '@components/Button.astro';
import SectionTitle from '@components/SectionTitle.astro';
import ProjectMark from './ProjectMark.astro';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, shortDescription, eyebrow, meta } = project;
---

<section class="max-w-content-xxl mx-auto px-6 md:px-12 pt-16 pb-8 animate-fade-in">
  <Button
    href="/#projects"
    variant="naked"
    icon="←"
    className="text-on-surface-variant hover:text-primary mb-8 text-sm"
  >
    Back to projects
  </Button>

  <article>
    <div class="flex items-center gap-3 mb-2">
      <ProjectMark project={project} size="lg" />
      {
        eyebrow && (
          <p class="text-sm font-semibold tracking-wide uppercase text-primary">
            {eyebrow}
          </p>
        )
      }
    </div>

    <SectionTitle title={title} tag="h1" />

    <p class="text-xl text-on-background mb-6 max-w-2xl">
      {shortDescription}
    </p>

    {
      meta && meta.length > 0 && (
        <ul class="flex flex-wrap gap-3" aria-label="Project details">
          {meta.map((item) => (
            <li class="px-3 py-1.5 text-sm rounded-md bg-surface-container-high text-on-surface-variant">
              <span class="font-semibold text-on-background">
                {item.label}:
              </span>
              {item.value}
            </li>
          ))}
        </ul>
      )
    }
  </article>
</section>
