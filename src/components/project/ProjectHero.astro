---
import Button from '@components/Button.astro';
import SectionTitle from '@components/SectionTitle.astro';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  title,
  shortDescription,
  eyebrow,
  meta,
  heroImage,
  heroImageAlt,
  imageUrl,
  imageAlt,
} = project;

const resolvedImage = heroImage || imageUrl;
const resolvedImageAlt = heroImageAlt || imageAlt;
---

<section class="max-w-content-xxl mx-auto px-6 md:px-12 pt-16 pb-8 animate-fade-in">
  <Button
    href="/#projects"
    variant="naked"
    icon="←"
    className="text-on-surface-variant hover:text-primary mb-8 text-sm"
  >
    Back to projects
  </Button>

  <article>
    {
      eyebrow && (
        <p class="text-sm font-semibold tracking-wide uppercase text-primary mb-2">
          {eyebrow}
        </p>
      )
    }

    <SectionTitle title={title} tag="h1" />

    <p class="text-xl text-on-background mb-6 max-w-2xl">
      {shortDescription}
    </p>

    {
      meta && meta.length > 0 && (
        <ul class="flex flex-wrap gap-3 mb-8" aria-label="Project details">
          {meta.map((item) => (
            <li class="px-3 py-1.5 text-sm rounded-md bg-surface-container-high text-on-surface-variant">
              <span class="font-semibold text-on-background">
                {item.label}:
              </span>
              {item.value}
            </li>
          ))}
        </ul>
      )
    }

    {
      resolvedImage ? (
        <img
          src={resolvedImage}
          alt={resolvedImageAlt}
          class="w-full aspect-[16/9] object-cover rounded-xl"
        />
      ) : (
        <div
          role="img"
          aria-label={resolvedImageAlt}
          class="w-full aspect-[16/9] bg-surface-container-high rounded-xl flex items-center justify-center"
        >
          <span class="text-on-surface-variant text-sm">
            Image coming soon
          </span>
        </div>
      )
    }
  </article>
</section>
