---
import Section from '@components/Section.astro';
import SectionTitle from '@components/SectionTitle.astro';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { fullDescription, architecture, keyFeatures, highlights } = project;
---

<Section id="overview">
  <div class="py-8 flex flex-col gap-10">
    <div>
      <SectionTitle title="Overview" id="overview-heading" />
      <p class="text-lg text-on-background max-w-3xl">{fullDescription}</p>
    </div>

    {
      architecture && architecture.length > 0 && (
        <div>
          <h3 class="font-display text-2xl font-bold text-on-background mb-4">Architecture</h3>
          <ul class="flex flex-col gap-3 max-w-3xl">
            {architecture.map((point, index) => (
              <li class="flex items-start gap-3">
                <span class="font-display flex size-6 shrink-0 items-center justify-center rounded bg-primary text-xs font-bold text-on-primary mt-0.5">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="text-on-surface-variant">{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      keyFeatures && keyFeatures.length > 0 && (
        <div>
          <h3 class="font-display text-2xl font-bold text-on-background mb-4">Key Features</h3>

          <swiper-container
            class="features-swiper block md:hidden"
            init="false"
            slides-per-view="1.15"
            space-between="16"
            pagination="true"
            grab-cursor="true"
          >
            {keyFeatures.map((feature, index) => (
              <swiper-slide>
                <div class="feature-card hard-shadow-hover relative p-4 rounded-xl bg-surface-container-high border-2 border-outline-variant h-full">
                  <span class="feature-card__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <p class="relative z-10 text-on-surface-variant">{feature}</p>
                </div>
              </swiper-slide>
            ))}
          </swiper-container>

          <div class="hidden md:grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {keyFeatures.map((feature, index) => (
              <div class="feature-card hard-shadow-hover relative p-4 rounded-xl bg-surface-container-high border-2 border-outline-variant">
                <span class="feature-card__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="relative text-on-surface-variant">{feature}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      highlights && highlights.length > 0 && (
        <div>
          <h3 class="font-display text-2xl font-bold text-on-background mb-4">
            Notable Highlights
          </h3>
          <ul class="flex flex-col gap-4 max-w-3xl">
            {highlights.map((point) => (
              <li class="flex items-start gap-3">
                <span
                  class="font-display shrink-0 text-xl leading-none text-primary mt-0.5"
                  aria-hidden="true"
                >
                  ★
                </span>
                <span class="highlight-mark font-medium text-on-background">
                  {point}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>

<style>
  .feature-card__index {
    position: absolute;
    z-index: 0;
    top: 0.75rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.15;
    pointer-events: none;
  }

  .highlight-mark {
    background-image: linear-gradient(
      to bottom,
      transparent 60%,
      var(--color-section-snake-inner) 60%
    );
    padding: 0 0.2em;
    margin: 0 -0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>

<script>
  import { register } from 'swiper/element/bundle';

  type SwiperContainerElement = HTMLElement & {
    speed: number;
    initialize: () => void;
  };

  register();

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches;

  document
    .querySelectorAll<SwiperContainerElement>('.features-swiper')
    .forEach((swiperEl) => {
      swiperEl.speed = prefersReducedMotion ? 0 : 300;
      swiperEl.initialize();
    });
</script>
