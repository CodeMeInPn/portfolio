---
import BandHeading from '@components/BandHeading.astro';
import TechItem from './TechItem.astro';
import type { Project } from '../../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { techStack, technologies } = project;
---

{/* Pills wrap at every width (no slider), so nothing is hidden off-screen. */}
<section id="tech-stack" aria-labelledby="tech-stack-heading">
  <BandHeading title="Technologies" id="tech-stack-heading" level="h2" />

  {
    techStack && techStack.length > 0 ? (
      <div class="flex flex-col gap-8">
        {techStack.map((group) => (
          <div>
            <h3 class="font-display text-lg text-on-background mb-3">
              {group.category}
            </h3>
            <ul class="flex flex-wrap gap-3">
              {group.items.map((item) => (
                <li class="max-w-full">
                  <TechItem name={item.name} icon={item.icon} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <ul class="flex flex-wrap gap-2" aria-label="Technologies">
        {technologies.map((tech) => (
          <li class="max-w-full">
            <TechItem name={tech} />
          </li>
        ))}
      </ul>
    )
  }
</section>
