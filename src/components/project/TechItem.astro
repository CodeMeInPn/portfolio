---
interface Props {
  name: string;
  icon?: string;
}

const { name, icon } = Astro.props;
---

{/* A one-line pill is 40px tall (py-2 + 20px line + 2px borders), so a
    1.25rem radius is identical to rounded-full on one line, and becomes a
    soft rounded box when a long name wraps instead of overflowing. */}
<div
  class="hard-shadow-hover flex max-w-full items-center gap-2 px-3 py-2 rounded-[1.25rem] bg-surface-container-high border-2 border-outline-variant"
>
  {
    icon ? (
      <img src={icon} alt="" class="size-5 object-contain shrink-0" />
    ) : (
      <div
        role="img"
        aria-label={`${name} icon coming soon`}
        class="size-5 bg-surface-container-highest rounded shrink-0"
      />
    )
  }
  {/* overflow-wrap: anywhere — some names hold long slash-joined tokens
      ("(title/description/canonical/OG/hreflang)") with no break point. */}
  <span class="min-w-0 text-sm text-on-surface-variant [overflow-wrap:anywhere]">
    {name}
  </span>
</div>
