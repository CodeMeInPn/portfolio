---
import { cn } from 'utils/cn';
import type { Project } from '../../types/project';

interface Props {
  stats: NonNullable<Project['stats']>;
}

const { stats } = Astro.props;
const hasOddCount = stats.length % 2 === 1;
---

{/* Left-aligned with the band heading so 1, 2 or 3 stats all read
    naturally. The value is shown above its label (flex-col-reverse), but a
    <dl> group must be dt then dd, so screen readers get "label, value".
    Count-up: observeCountUp('.stat-strip__value'). */}
<dl
  class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-none sm:grid-flow-col sm:auto-cols-[minmax(0,max-content)] sm:gap-x-0"
>
  {
    stats.map((stat, index) => (
      <div
        class={cn(
          // justify-end = top in a column-reverse, so values line up
          // even when one label wraps to more lines than its neighbours.
          'stat-strip__item flex flex-col-reverse justify-end gap-1 sm:px-10 sm:first:pl-0',
          hasOddCount &&
            index === stats.length - 1 &&
            'col-span-2 sm:col-span-1'
        )}
      >
        <dt class="text-sm text-on-surface-variant max-w-[16rem]">
          {stat.label}
        </dt>
        <dd
          class="stat-strip__value font-display text-4xl md:text-5xl text-on-background"
          data-count-value={stat.value}
        >
          {stat.value}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .stat-strip__item {
    position: relative;
  }

  /* Short vertical tri-stripe between items: outer/inner as solid side
     borders around a solid middle fill — three flat colors, no gradient.
     From sm up only; the mobile grid separates items with gaps instead. */
  @media (min-width: 40rem) {
    .stat-strip__item + .stat-strip__item::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      box-sizing: border-box;
      width: 6px;
      height: 3.5rem;
      transform: translate(-50%, -50%);
      border-left: 2px solid var(--color-section-snake-outer);
      border-right: 2px solid var(--color-section-snake-inner);
      background-color: var(--color-section-snake-middle);
    }
  }
</style>
